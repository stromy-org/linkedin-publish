# Environment variables for linkedin-publish.
# Copy to .env and fill in values. .env is gitignored and must never be committed.
#
# NOTE: this library resolves NO credentials itself. It takes an injected
# CredentialProvider, which is what keeps it client-neutral and testable without
# secrets. LinkedIn member tokens and app secrets live in the hosted MCP's
# versioned Key Vault references (linkedin-mcp) — never here, never in a tool
# argument, never in a query string, and never in argv.

# Postgres DSN for the operator CLI (`linkedin-publish db migrate`, account and
# approval commands). Use the MIGRATION identity for migrate, not the runtime
# role. Value shape: postgres://USER:PASSWORD@HOST:5432/DATABASE
LINKEDIN_PUBLISH_DSN=

# How ledger connections log in. `password` (default) uses the DSN as written.
# `entra` is for Azure Database for PostgreSQL with Microsoft Entra auth: the DSN
# names the principal and carries NO password, and each connection presents a
# token from a managed identity or `az login` (needs the `azure` extra).
LINKEDIN_PUBLISH_PG_AUTH=password
# With entra, on a host carrying several managed identities: the one to use.
LINKEDIN_PUBLISH_PG_IDENTITY_CLIENT_ID=

# Postgres DSN used only by `uv run pytest tests/integration`. Point it at a
# disposable database — the fixtures TRUNCATE the schema between tests.
# Unset means those tests SKIP, which is a NOT-RUN, not a pass.
#   docker run --rm -e POSTGRES_PASSWORD=pg -p 5432:5432 postgres:16
LINKEDIN_PUBLISH_TEST_DSN=
