diff a/.github/workflows/ci.yml b/.github/workflows/ci.yml	(rejected hunks)
@@ -7,21 +29,69 @@ on:
     branches: [main]
 
 jobs:
-  python-ci:
-    # ci-dedup (inside the reusable workflow) reads the merged PR behind a push
-    # and that PR's workflow runs. The org default token grants contents+packages
-    # only, so without these the action 403s on every push and silently never
-    # skips — the checks then run twice per change, which is the cost it exists to
-    # remove. A called workflow inherits this job's grant and can only downgrade
-    # it, so it has to be declared here rather than in ci-python.yml.
-    permissions:
-      contents: read
-      packages: read
-      pull-requests: read
-      actions: read
-    uses: stromy-org/stromy-org/.github/workflows/ci-python.yml@main
-    with:
-      source_package: "src/linkedin_publish"
-    # Forward the org stromy-ci App secrets (CI_APP_ID / CI_APP_PRIVATE_KEY)
-    # so the reusable workflow can clone private deps. No-op if absent.
-    secrets: inherit
+  quality:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+      - uses: astral-sh/setup-uv@v5
+        with:
+          version: "latest"
+      - run: uv python install 3.12
+      # `--extra postgres` matters: without asyncpg installed, pyright cannot
+      # resolve the import in postgres.py and would silently type-check less
+      # than it appears to.
+      - run: uv sync --extra postgres
+      - name: Lint
+        run: uv run ruff check
+      - name: Type check
+        run: uv run pyright
+
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+      - uses: astral-sh/setup-uv@v5
+        with:
+          version: "latest"
+      - run: uv python install 3.12
+      - run: uv sync --extra postgres
+      - name: Tests
+        # Offline tiers only. The integration tier has its own job with a
+        # Postgres service; collecting it here would hit the conftest guard that
+        # turns a CI skip into a failure — correctly, since there is no database
+        # in this job.
+        run: uv run pytest tests/unit tests/contract -v
+
+  # The durable tier needs a real Postgres: multi-process compare-and-set,
+  # transactional rollback of partial quota reservations, and column-level GRANTs
+  # actually refusing a write. None of it is provable against an in-memory store,
+  # so it runs here rather than being left to a developer's machine — where it
+  # skipped, and a skip is a NOT-RUN, not a pass.
+  integration:
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:16
+        env:
+          POSTGRES_PASSWORD: postgres
+        options: >-
+          --health-cmd pg_isready
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+        ports:
+          - 5432:5432
+    steps:
+      - uses: actions/checkout@v5
+      - uses: astral-sh/setup-uv@v5
+        with:
+          version: "latest"
+      - run: uv python install 3.12
+      - run: uv sync --extra postgres
+      - name: Integration tests
+        env:
+          LINKEDIN_PUBLISH_TEST_DSN: postgres://postgres:postgres@localhost:5432/postgres
+        # A skipped tier here is a failure, not a pass — enforced in
+        # tests/integration/conftest.py, which fails rather than skips when CI is
+        # set and the DSN is missing.
+        run: uv run pytest tests/integration -v
